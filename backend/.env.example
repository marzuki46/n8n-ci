#--------------------------------------------------------------------
# .env.example — CONTOH konfigurasi untuk PRODUCTION
#
# Cara pakai:
#   1. Salin file ini menjadi `.env` di folder yang sama.
#      cp .env.example .env
#   2. Sesuaikan SEMUA nilai di bawah. JANGAN commit `.env` asli.
#   3. Setiap perubahan .env baru berlaku setelah restart web server
#      (PHP-FPM perlu reload).
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# production = tidak menampilkan error/debug bar. development = hanya lokal.
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# URL publik aplikasi. WAJIB diisi, tanpa trailing slash.
# Contoh: app.baseURL = 'https://app.example.com/'
app.baseURL = 'https://mas.juki.eu.org/'

# Paksa semua request lewat HTTPS. Aktifkan di production.
# app.forceGlobalSecureRequests = true

# Matikan CSP kecuali kamu benar-benar membutuhkannya.
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# DB utama (MySQL/MariaDB). Jangan pakai user root di production.
database.default.hostname = 127.0.0.1
database.default.database = n8n_codeigniter
database.default.username = db_user
database.default.password = 'GANTI_DENGAN_PASSWORD_KUAT'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# DB untuk PHPUnit (opsional, hanya untuk development)
# database.tests.hostname = 127.0.0.1
# database.tests.database = n8n_codeigniter_test
# database.tests.username = root
# database.tests.password =
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Kunci enkripsi credential (AES-256). WAJIB diganti dengan nilai acak 32 byte.
# Cara generate aman (Linux):
#   php -r "echo bin2hex(random_bytes(32));"
# Jika kunci diganti setelah produksi, SEMUA credential lama tidak bisa
# didekripsi lagi. Simpan kunci ini di tempat aman & sertakan saat backup.
encryption.key = 'GANTI_48_KARAKTER_HEX_ACAK_9a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f'

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# FileHandler cukup untuk shared hosting sederhana.
# Untuk skala lebih besar pertimbangkan DatabaseHandler (tabel `ci_sessions`).
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null
session.expiration = 7200
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# RATE LIMIT / THROTTLE (login & endpoint publik)
#--------------------------------------------------------------------
# Jumlah maksimum percobaan login gagal dalam satu jendela waktu.
# Terlalu kecil → user sah bisa terkunci ("Terlalu banyak percobaan").
# Terlalu besar → mengurangi proteksi brute-force.
# Nilai berikut dibaca oleh app/Filters/ThrottleFilter.php.
THROTTLE_MAX_ATTEMPTS = 10
THROTTLE_WINDOW = 900

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# 0 = mati, 1-8 = severity. Di production biasanya 1 (emergency) atau 3 (error).
logger.threshold = 3

#--------------------------------------------------------------------
# CORS (opsional)
#--------------------------------------------------------------------

# Hanya perlu diisi bila frontend & backend beda origin (contoh SPA di
# subdomain lain). Pisahkan beberapa origin dengan koma.
# Kosongkan/komentari bila frontend disajikan dari public/ yang sama
# (same-origin, CORS tidak berlaku).
# cors.allowedOrigins = https://app.example.com,https://admin.example.com

#--------------------------------------------------------------------
# EMAIL (WAJIB bila ingin menerima verifikasi / notifikasi login)
#--------------------------------------------------------------------
# Default = PHP mail() yang TIDAK berfungsi di kebanyakan shared hosting.
# Fitur "ganti email" & "notifikasi login dari perangkat baru" butuh SMTP.
# Aktifkan salah satu opsi di bawah (hapus tanda # pada baris yang dipakai).

# --- Opsi A: SMTP hosting cPanel (buat akun email di cPanel dulu) ---
# email.protocol   = smtp
# email.SMTPHost   = mail.NAMADOMAIN.com
# email.SMTPPort   = 465
# email.SMTPUser   = akun@NAMADOMAIN.com
# email.SMTPPass   = PASSWORD_EMAIL_C_PANEL
# email.SMTPCrypto = tls
# email.SMTPTimeout = 5
# email.mailType   = text
# email.fromEmail  = akun@NAMADOMAIN.com
# email.fromName   = "FlowForge n8n-CI"

# --- Opsi B: Gmail via App Password (aktifkan 2FA dulu) ---
# email.protocol   = smtp
# email.SMTPHost   = smtp.gmail.com
# email.SMTPPort   = 587
# email.SMTPUser   = EMAIL_GMAIL_ANDA
# email.SMTPPass   = APP_PASSWORD_16_KARAKTER
# email.SMTPCrypto = tls
# email.SMTPTimeout = 10
# email.mailType   = text
# email.fromEmail  = EMAIL_GMAIL_ANDA
# email.fromName   = "FlowForge n8n-CI"

# PENTING: nilai yang mengandung SPASI (seperti fromName) WAJIB dibungkus
# tanda kutip ganda (", bukan '), jika tidak CI4 DotEnv gagal mem-parse .env
# dan mengakibatkan HTTP 500 di shared hosting.
