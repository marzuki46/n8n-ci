{
    "slug": "seo-mass-on-page-audit",
    "name": "SEO – Mass On-Page Audit",
    "description": "Audit seluruh URL di sitemap: title/meta/H1/canonical/noindex per halaman, laporkan yang bermasalah.",
    "category": "Technical SEO",
    "workflow": {
        "name": "SEO – Mass On-Page Audit",
        "description": "Audit seluruh URL di sitemap: title/meta/H1/canonical/noindex per halaman, laporkan yang bermasalah.",
        "nodes": [
            {
                "id": "trig",
                "name": "Mulai",
                "type": "manual_trigger",
                "position": [
                    40,
                    120
                ],
                "parameters": {
                    "payload": {
                        "sitemap_url": "http://127.0.0.1:8081/test-sitemap-pages.xml"
                    }
                }
            },
            {
                "id": "fetch",
                "name": "Fetch Sitemap",
                "type": "http_request",
                "position": [
                    260,
                    120
                ],
                "parameters": {
                    "method": "GET",
                    "url": "{{$json.sitemap_url}}",
                    "timeout": 15,
                    "onError": "continue"
                }
            },
            {
                "id": "locs",
                "name": "Extract URL",
                "type": "code",
                "position": [
                    480,
                    120
                ],
                "parameters": {
                    "entryPoint": "Run Once for All Items",
                    "code": "const raw = (items[0] && items[0].json !== undefined) ? items[0].json : '';\nconst xml = typeof raw === 'string' ? raw : JSON.stringify(raw);\nconst locs = [];\nxml.replace(/<loc>\\s*([^<\\s]+)\\s*<\\/loc>/gi, function(m, u){ locs.push(u); return m; });\nreturn locs.map(function(u){ return { json: { url: u } }; });"
                }
            },
            {
                "id": "getpage",
                "name": "Fetch Tiap Halaman",
                "type": "http_request",
                "position": [
                    700,
                    120
                ],
                "parameters": {
                    "method": "GET",
                    "url": "{{$json.url}}",
                    "timeout": 15,
                    "onError": "continue"
                }
            },
            {
                "id": "audit",
                "name": "Audit Per Halaman",
                "type": "code",
                "position": [
                    920,
                    120
                ],
                "parameters": {
                    "entryPoint": "Run Once for Each Item",
                    "code": "var html = String(item.json || '');\nvar url = item.url || '';\nfunction m(re){ var r = html.match(re); return r ? r[1] : ''; }\nvar title = m(/<title[^>]*>([\\s\\S]*?)<\\/title>/i).trim();\nvar dm = html.match(/<meta[^>]+name=[\"']description[\"'][^>]*content=[\"']([^\"']*)[\"']/i);\nvar desc = dm ? dm[1] : '';\nvar h1s = html.match(/<h1[\\s>]/gi) || [];\nvar canon = m(/<link[^>]+rel=[\"']canonical[\"'][^>]*href=[\"']([^\"']+)[\"']/i);\nvar noindex = /name=[\"']robots[\"'][^>]*content=[\"'][^\"']*noindex/i.test(html);\nvar issues = [];\nif (!title) issues.push('Title kosong'); else if (title.length > 65) issues.push('Title terlalu panjang (' + title.length + ')');\nif (!desc) issues.push('Meta description kosong'); else if (desc.length > 165) issues.push('Meta description terlalu panjang');\nif (h1s.length === 0) issues.push('H1 tidak ada'); else if (h1s.length > 1) issues.push('H1 ganda (' + h1s.length + ')');\nif (!canon) issues.push('Canonical tidak ada');\nif (noindex) issues.push('noindex terdeteksi');\nreturn { json: { url: url, title: title.slice(0, 200), h1_count: h1s.length, noindex: noindex, issue_count: issues.length, issues: issues } };"
                }
            },
            {
                "id": "problem",
                "name": "Yang Bermasalah",
                "type": "filter",
                "position": [
                    1140,
                    120
                ],
                "parameters": {
                    "matchType": "all",
                    "conditions": [
                        {
                            "left": "{{$json.issue_count}}",
                            "operator": ">",
                            "right": 0
                        }
                    ]
                }
            },
            {
                "id": "log",
                "name": "Catat Isu",
                "type": "log",
                "position": [
                    1360,
                    120
                ],
                "parameters": {
                    "level": "warning",
                    "message": "{{$json.url}} → {{JSON.stringify($json.issues)}}"
                }
            }
        ],
        "connections": [
            {
                "source": "trig",
                "target": "fetch",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "fetch",
                "target": "locs",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "locs",
                "target": "getpage",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "getpage",
                "target": "audit",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "audit",
                "target": "problem",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "problem",
                "target": "log",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            }
        ]
    }
}