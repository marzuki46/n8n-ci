{
    "slug": "seo-broken-link-sitemap-checker",
    "name": "SEO – Broken Link & Sitemap Checker",
    "description": "Ambil sitemap.xml, cek tiap URL, laporkan yang broken (>=400).",
    "category": "Technical SEO",
    "workflow": {
        "name": "SEO – Broken Link & Sitemap Checker",
        "description": "Ambil sitemap.xml, cek tiap URL, laporkan yang broken (>=400).",
        "nodes": [
            {
                "id": "trig",
                "name": "Mulai",
                "type": "manual_trigger",
                "position": [
                    40,
                    120
                ],
                "parameters": {
                    "payload": {
                        "sitemap_url": "https://situs-anda.com/sitemap.xml"
                    }
                }
            },
            {
                "id": "fetch",
                "name": "Fetch Sitemap",
                "type": "http_request",
                "position": [
                    300,
                    120
                ],
                "parameters": {
                    "method": "GET",
                    "url": "{{$json.sitemap_url}}",
                    "timeout": 15,
                    "onError": "continue"
                }
            },
            {
                "id": "extract",
                "name": "Extract URL",
                "type": "code",
                "position": [
                    560,
                    120
                ],
                "parameters": {
                    "entryPoint": "Run Once for All Items",
                    "code": "const raw = (items[0] && items[0].json !== undefined) ? items[0].json : '';\nconst xml = typeof raw === 'string' ? raw : JSON.stringify(raw);\nconst locs = [];\nxml.replace(/<loc>\\s*([^<\\s]+)\\s*<\\/loc>/gi, function(m, u){ locs.push(u); return m; });\nreturn locs.map(function(u){ return { json: { url: u } }; });"
                }
            },
            {
                "id": "check",
                "name": "Cek Tiap URL",
                "type": "http_request",
                "position": [
                    820,
                    120
                ],
                "parameters": {
                    "method": "GET",
                    "url": "{{$json.url}}",
                    "timeout": 10,
                    "onError": "continue"
                }
            },
            {
                "id": "norm",
                "name": "Normalisasi Hasil",
                "type": "code",
                "position": [
                    1080,
                    120
                ],
                "parameters": {
                    "entryPoint": "Run Once for Each Item",
                    "code": "return { json: { url: item.url || '', status: Number(item.status) || 0, error: item.error || null } };"
                }
            },
            {
                "id": "broken",
                "name": "Hanya Broken",
                "type": "filter",
                "position": [
                    1340,
                    120
                ],
                "parameters": {
                    "matchType": "all",
                    "conditions": [
                        {
                            "left": "{{$json.status}}",
                            "operator": ">=",
                            "right": 400
                        }
                    ]
                }
            },
            {
                "id": "log",
                "name": "Catat Broken",
                "type": "log",
                "position": [
                    1600,
                    120
                ],
                "parameters": {
                    "level": "warning",
                    "message": "BROKEN: {{$json.url}} (status {{$json.status}})"
                }
            }
        ],
        "connections": [
            {
                "source": "trig",
                "target": "fetch",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "fetch",
                "target": "extract",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "extract",
                "target": "check",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "check",
                "target": "norm",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "norm",
                "target": "broken",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "broken",
                "target": "log",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            }
        ]
    }
}