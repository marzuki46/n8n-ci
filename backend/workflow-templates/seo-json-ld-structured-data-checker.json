{
    "slug": "seo-json-ld-structured-data-checker",
    "name": "SEO – JSON-LD Structured Data Checker",
    "description": "Validasi blok JSON-LD pada halaman: jumlah, validitas, tipe schema.",
    "category": "Technical SEO",
    "workflow": {
        "name": "SEO – JSON-LD Structured Data Checker",
        "description": "Validasi blok JSON-LD pada halaman: jumlah, validitas, tipe schema.",
        "nodes": [
            {
                "id": "trig",
                "name": "Mulai",
                "type": "manual_trigger",
                "position": [
                    40,
                    120
                ],
                "parameters": {
                    "payload": {
                        "page_url": "http://127.0.0.1:8081/test-page.html"
                    }
                }
            },
            {
                "id": "fetch",
                "name": "Fetch Halaman",
                "type": "http_request",
                "position": [
                    300,
                    120
                ],
                "parameters": {
                    "method": "GET",
                    "url": "{{$json.page_url}}",
                    "timeout": 20,
                    "onError": "continue"
                }
            },
            {
                "id": "check",
                "name": "Validasi JSON-LD",
                "type": "code",
                "position": [
                    560,
                    120
                ],
                "parameters": {
                    "entryPoint": "Run Once for All Items",
                    "code": "var html = String((items[0] && items[0].json) || '');\nvar blocks = [];\nhtml.replace(/<script[^>]+type=[\"']application\\/ld\\+json[\"'][^>]*>([\\s\\S]*?)<\\/script>/gi, function(m, body){\n  blocks.push(body.trim()); return m;\n});\nvar valid = 0, invalid = [], types = [];\nfor (var i = 0; i < blocks.length; i++) {\n  try {\n    var obj = JSON.parse(blocks[i]);\n    valid++;\n    types.push(obj['@type'] || obj.type || 'unknown');\n  } catch (e) {\n    invalid.push('Blok #' + (i + 1) + ' JSON tidak valid');\n  }\n}\nreturn [{ json: {\n  page: ((items[0] || {}).url) || '',\n  blocks_total: blocks.length,\n  blocks_valid: valid,\n  invalid_blocks: invalid,\n  schema_types: types\n} }];"
                }
            },
            {
                "id": "bad",
                "name": "Ada Blok Invalid",
                "type": "filter",
                "position": [
                    820,
                    120
                ],
                "parameters": {
                    "matchType": "all",
                    "conditions": [
                        {
                            "left": "{{$json.invalid_blocks}}",
                            "operator": "not empty",
                            "right": ""
                        }
                    ]
                }
            },
            {
                "id": "log",
                "name": "Lapor Invalid",
                "type": "log",
                "position": [
                    1060,
                    120
                ],
                "parameters": {
                    "level": "warning",
                    "message": "JSON-LD INVALID: {{JSON.stringify($json.invalid_blocks)}}"
                }
            }
        ],
        "connections": [
            {
                "source": "trig",
                "target": "fetch",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "fetch",
                "target": "check",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "check",
                "target": "bad",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "bad",
                "target": "log",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            }
        ]
    }
}