{
    "slug": "seo-https-www-redirect-consistency",
    "name": "SEO – HTTPS & WWW Redirect Consistency",
    "description": "Pastikan varian http/www semua dialihkan ke versi kanonik.",
    "category": "Technical SEO",
    "workflow": {
        "name": "SEO – HTTPS & WWW Redirect Consistency",
        "description": "Pastikan varian http/www semua dialihkan ke versi kanonik.",
        "nodes": [
            {
                "id": "trig",
                "name": "Mulai",
                "type": "manual_trigger",
                "position": [
                    40,
                    120
                ],
                "parameters": {
                    "payload": {
                        "domain": "situs-anda.com"
                    }
                }
            },
            {
                "id": "mk",
                "name": "Buat Varian URL",
                "type": "code",
                "position": [
                    300,
                    120
                ],
                "parameters": {
                    "entryPoint": "Run Once for All Items",
                    "code": "var d = ((items[0]||{}).json||{}).domain || '';\nreturn [\n  { json: { check_url: 'http://' + d } },\n  { json: { check_url: 'http://www.' + d } },\n  { json: { check_url: 'https://www.' + d } }\n];"
                }
            },
            {
                "id": "get",
                "name": "Cek Varian",
                "type": "http_request",
                "position": [
                    560,
                    120
                ],
                "parameters": {
                    "method": "GET",
                    "url": "{{$json.check_url}}",
                    "timeout": 15,
                    "onError": "continue"
                }
            },
            {
                "id": "ev",
                "name": "Evaluasi",
                "type": "code",
                "position": [
                    820,
                    120
                ],
                "parameters": {
                    "entryPoint": "Run Once for All Items",
                    "code": "var out = [];\nfor (var i = 0; i < items.length; i++) {\n  var it = items[i];\n  var st = Number(it.status) || 0;\n  out.push({ json: { check_url: it.url || '', final_status: st, ok: st >= 200 && st < 400 && !it.error } });\n}\nreturn out;"
                }
            },
            {
                "id": "bad",
                "name": "Varian Bermasalah",
                "type": "filter",
                "position": [
                    1080,
                    120
                ],
                "parameters": {
                    "matchType": "all",
                    "conditions": [
                        {
                            "left": "{{$json.ok}}",
                            "operator": "==",
                            "right": false
                        }
                    ]
                }
            },
            {
                "id": "log",
                "name": "Lapor",
                "type": "log",
                "position": [
                    1320,
                    120
                ],
                "parameters": {
                    "level": "warning",
                    "message": "REDIRECT BERMASALAH: {{$json.check_url}} (final status {{$json.final_status}})"
                }
            }
        ],
        "connections": [
            {
                "source": "trig",
                "target": "mk",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "mk",
                "target": "get",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "get",
                "target": "ev",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "ev",
                "target": "bad",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "bad",
                "target": "log",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            }
        ]
    }
}