{
    "slug": "seo-mixed-content-checker",
    "name": "SEO – Mixed Content Checker",
    "description": "Deteksi resource http:// di halaman https (penyebab warning \"Not Secure\").",
    "category": "Technical SEO",
    "workflow": {
        "name": "SEO – Mixed Content Checker",
        "description": "Deteksi resource http:// di halaman https (penyebab warning \"Not Secure\").",
        "nodes": [
            {
                "id": "trig",
                "name": "Mulai",
                "type": "manual_trigger",
                "position": [
                    40,
                    120
                ],
                "parameters": {
                    "payload": {
                        "page_url": "https://situs-anda.com/"
                    }
                }
            },
            {
                "id": "fetch",
                "name": "Fetch Halaman",
                "type": "http_request",
                "position": [
                    300,
                    120
                ],
                "parameters": {
                    "method": "GET",
                    "url": "{{$json.page_url}}",
                    "timeout": 20,
                    "onError": "continue"
                }
            },
            {
                "id": "check",
                "name": "Cek Mixed Content",
                "type": "code",
                "position": [
                    560,
                    120
                ],
                "parameters": {
                    "entryPoint": "Run Once for All Items",
                    "code": "var html = String((items[0] && items[0].json) || '');\nvar insecure = [];\nhtml.replace(/(?:src|href)=[\"'](http:\\/\\/[^\"']+)[\"']/gi, function(m, u){ insecure.push(u); return m; });\nreturn [{ json: {\n  page: ((items[0] || {}).url) || '',\n  mixed_content_count: insecure.length,\n  examples: insecure.slice(0, 5),\n  status: items[0] ? items[0].status : 0\n} }];"
                }
            },
            {
                "id": "bad",
                "name": "Ada Mixed Content",
                "type": "filter",
                "position": [
                    820,
                    120
                ],
                "parameters": {
                    "matchType": "all",
                    "conditions": [
                        {
                            "left": "{{$json.mixed_content_count}}",
                            "operator": ">",
                            "right": 0
                        }
                    ]
                }
            },
            {
                "id": "log",
                "name": "Lapor",
                "type": "log",
                "position": [
                    1060,
                    120
                ],
                "parameters": {
                    "level": "warning",
                    "message": "MIXED CONTENT {{$json.mixed_content_count}}: {{JSON.stringify($json.examples)}}"
                }
            }
        ],
        "connections": [
            {
                "source": "trig",
                "target": "fetch",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "fetch",
                "target": "check",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "check",
                "target": "bad",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "bad",
                "target": "log",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            }
        ]
    }
}