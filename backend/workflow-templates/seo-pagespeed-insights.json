{
    "slug": "seo-pagespeed-insights",
    "name": "SEO – PageSpeed Insights",
    "description": "Skor Lighthouse mobile via PSI API (butuh API key Google Cloud gratis).",
    "category": "Technical SEO",
    "workflow": {
        "name": "SEO – PageSpeed Insights",
        "description": "Skor Lighthouse mobile via PSI API (butuh API key Google Cloud gratis).",
        "nodes": [
            {
                "id": "trig",
                "name": "Mulai",
                "type": "manual_trigger",
                "position": [
                    40,
                    120
                ],
                "parameters": {
                    "payload": {
                        "page_url": "https://situs-anda.com/",
                        "psi_key": "ISI_API_KEY_GOOGLE"
                    }
                }
            },
            {
                "id": "psi",
                "name": "PSI Mobile",
                "type": "http_request",
                "position": [
                    300,
                    120
                ],
                "parameters": {
                    "method": "GET",
                    "url": "https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url={{$json.page_url}}&strategy=mobile&key={{$json.psi_key}}",
                    "timeout": 90,
                    "onError": "continue"
                }
            },
            {
                "id": "sum",
                "name": "Ringkas Skor",
                "type": "code",
                "position": [
                    560,
                    120
                ],
                "parameters": {
                    "entryPoint": "Run Once for All Items",
                    "code": "var d = (items[0] && items[0].json) || {};\nvar lh = d.lighthouseResult || {};\nvar cat = lh.categories || {};\nfunction score(k){ return cat[k] && typeof cat[k].score === 'number' ? Math.round(cat[k].score * 100) : null; }\nreturn [{ json: {\n  page: ((items[0] || {}).url) || '',\n  performance: score('performance'),\n  accessibility: score('accessibility'),\n  best_practices: score('best-practices'),\n  seo: score('seo'),\n  error: d.error ? (d.error.message || 'API error') : null\n} }];"
                }
            }
        ],
        "connections": [
            {
                "source": "trig",
                "target": "psi",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "psi",
                "target": "sum",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            }
        ]
    }
}