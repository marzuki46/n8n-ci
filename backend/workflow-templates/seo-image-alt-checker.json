{
    "slug": "seo-image-alt-checker",
    "name": "SEO – Image Alt Checker",
    "description": "Hitung gambar tanpa attribute alt pada satu halaman.",
    "category": "Technical SEO",
    "workflow": {
        "name": "SEO – Image Alt Checker",
        "description": "Hitung gambar tanpa attribute alt pada satu halaman.",
        "nodes": [
            {
                "id": "trig",
                "name": "Mulai",
                "type": "manual_trigger",
                "position": [
                    40,
                    120
                ],
                "parameters": {
                    "payload": {
                        "page_url": "http://127.0.0.1:8081/test-page.html"
                    }
                }
            },
            {
                "id": "fetch",
                "name": "Fetch Halaman",
                "type": "http_request",
                "position": [
                    300,
                    120
                ],
                "parameters": {
                    "method": "GET",
                    "url": "{{$json.page_url}}",
                    "timeout": 20,
                    "onError": "continue"
                }
            },
            {
                "id": "check",
                "name": "Cek Alt",
                "type": "code",
                "position": [
                    560,
                    120
                ],
                "parameters": {
                    "entryPoint": "Run Once for Each Item",
                    "code": "var html = String(item.json || '');\nvar imgs = html.match(/<img\\b[^>]*>/gi) || [];\nvar missing = [];\nfor (var i = 0; i < imgs.length; i++) {\n  if (!/\\balt=[\"'][^\"']+[\"']/i.test(imgs[i])) {\n    var srcm = imgs[i].match(/src=[\"']([^\"']+)[\"']/i);\n    missing.push(srcm ? srcm[1] : '(tanpa src)');\n  }\n}\nreturn { json: { url: item.url || '', img_total: imgs.length, img_missing_alt: missing.length, examples: missing.slice(0, 5) } };"
                }
            },
            {
                "id": "bad",
                "name": "Ada Yang Kurang",
                "type": "filter",
                "position": [
                    820,
                    120
                ],
                "parameters": {
                    "matchType": "all",
                    "conditions": [
                        {
                            "left": "{{$json.img_missing_alt}}",
                            "operator": ">",
                            "right": 0
                        }
                    ]
                }
            },
            {
                "id": "log",
                "name": "Lapor",
                "type": "log",
                "position": [
                    1060,
                    120
                ],
                "parameters": {
                    "level": "warning",
                    "message": "IMG TANPA ALT {{$json.img_missing_alt}}/{{$json.img_total}} di {{$json.url}}: {{JSON.stringify($json.examples)}}"
                }
            }
        ],
        "connections": [
            {
                "source": "trig",
                "target": "fetch",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "fetch",
                "target": "check",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "check",
                "target": "bad",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            },
            {
                "source": "bad",
                "target": "log",
                "sourceHandle": "out-1",
                "targetHandle": "in-1"
            }
        ]
    }
}