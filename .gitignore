# ============================================
# n8n-CI — PRODUCTION (FLAT LAYOUT)
# Root = webroot. ZIP isi root ini langsung
# bisa diupload ke public_html.
# ============================================

# ---- Vendor / runtime ----
vendor/
*.log

# ---- writable: simpan hanya placeholder index.html / .htaccess ----
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html
writable/debugbar/*
!writable/debugbar/index.html

# ---- Source / dev (sudah ada di branch `main`) ----
frontend/
wordpress-plugin/
node_modules/
frontend/dist/

# ---- Env / Secrets ----
.env
.env.*
!.env.example

# ---- Dokumen (tidak ikut repo production) ----
*.md
*.MD

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# ---- Temp / cache lokal ----
.cache/
.codebase-memory/
tmp/